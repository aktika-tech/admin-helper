---
import type { MarkdownHeading } from 'astro';
import Sidebar from '../components/Sidebar.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  // id страницы в коллекции pages
  id: string;
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { id, title, description, headings = [] } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" href={withBase('favicon.ico')} sizes="any">
<title>{title}</title>
</head>
<body id="top">
<div class="layout">
  <Sidebar current={id} headings={headings} />
  <div class="page">
    <main class="content">
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <slot />
    </main>
    <footer class="site-footer">© {new Date().getFullYear()} Стоматологическая клиника «Актика»</footer>
  </div>
</div>
{id !== 'index' && (
  <Fragment>
    <div class="to-top-sentinel"></div>
    <a class="to-top" href="#top">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24"><path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="visually-hidden">Наверх</span>
    </a>
  </Fragment>
)}
<script is:inline>
  // Заголовки с id становятся ссылками на себя: клик ставит #id в адрес и прокручивает к заголовку
  for (const h of document.querySelectorAll('.content :is(h2, h3, h4)[id]')) {
    if (h.querySelector('a')) continue;
    const a = document.createElement('a');
    a.className = 'heading-link';
    a.href = '#' + encodeURIComponent(h.id);
    a.append(...h.childNodes);
    h.append(a);
  }

  // До 900px меню закрывается после выбора пункта, иначе переход к разделу остаётся под ним
  const menu = document.querySelector('.menu');
  menu?.addEventListener('click', (e) => {
    if (e.target.closest('a') && matchMedia('(max-width: 899px)').matches) menu.open = false;
  });

  // Кнопка «Наверх» видна, когда метка на высоте одного экрана ушла вверх за край окна.
  // Без скрипта кнопка видна всегда и всё равно работает как ссылка на #top
  const toTop = document.querySelector('.to-top');
  const sentinel = document.querySelector('.to-top-sentinel');
  if (toTop && sentinel && 'IntersectionObserver' in window) {
    const setHidden = (hidden) => {
      toTop.classList.toggle('is-hidden', hidden);
      toTop.toggleAttribute('aria-hidden', hidden);
      if (hidden) toTop.setAttribute('tabindex', '-1');
      else toTop.removeAttribute('tabindex');
    };
    setHidden(true);
    new IntersectionObserver(([entry]) => {
      setHidden(entry.isIntersecting || entry.boundingClientRect.top > 0);
    }).observe(sentinel);
  }
</script>
</body>
</html>
