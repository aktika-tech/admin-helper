---
import type { MarkdownHeading } from 'astro';
import Sidebar from '../components/Sidebar.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  // id страницы в коллекции pages
  id: string;
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { id, title, description, headings = [] } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href={withBase('favicon.ico')} sizes="any">
<title>{title}</title>
</head>
<body>
<div class="layout">
  <Sidebar current={id} headings={headings} />
  <main class="content">
    <h1>{title}</h1>
    {description && <p class="lead">{description}</p>}
    <slot />
    <footer>© Клиника</footer>
  </main>
</div>
</body>
</html>
