---
import { getCollection, getEntry } from 'astro:content';
import DoctorCard from '../components/DoctorCard.astro';
import Layout from '../layouts/Layout.astro';

// Текст страницы — src/content/pages/prezentaciavrachi.md, карточки — src/content/doctors/*.md
const page = (await getEntry('pages', 'prezentaciavrachi'))!;
const doctors = (await getCollection('doctors')).sort((a, b) => a.data.order - b.data.order);
const headings = doctors.map((d) => ({ depth: 2, slug: d.id, text: d.data.name }));
---
<Layout id={page.id} title={page.data.title} description={page.data.description} headings={headings}>
  {doctors.map((doctor) => <DoctorCard doctor={doctor} />)}
</Layout>
